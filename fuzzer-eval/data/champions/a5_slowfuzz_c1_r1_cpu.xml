		<adopt dest-doc="doc3" node="b"/>
		<append-child parent="p2" child="b"/>

		<reconcile-ns node="p2"/>
		<expected doc="doc3"><![CDATA[<p2 xmlns="urn:test:ZZZ"><a xmlns="urn:test:AAA"/><b xmlns="urn:test:BBB"/></p2>]]></expected>
	</test>

